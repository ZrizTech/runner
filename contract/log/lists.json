 "login_outcome_map": {
  "started": "login started",
  "minted": "login done",
  "limited": "login failed",
  "expired": "login failed",
  "bad-request": "login failed",
  "pending": "no line at all"
 },
 "ip_rule": {
  "key": "ip",
  "only_component": "cloud.auth",
  "other_components": "drop the key and count it"
 },
 "client_rule": {
  "key": "client",
  "header": "User-Agent",
  "regex": "^(zz|runner)/[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}\\+([0-9a-f]{12}|dev)$",
  "dialect": "POSIX ERE",
  "max_len": 37,
  "match": "print the header as is",
  "no_match": "leave the key out (also when the header is missing); never log or store the raw header",
  "_note": "A new kind of entry: a closed value by pattern, not by enum. The cloud checks the header once at the edge. zz and the runner test their own constant against this regex. Cases: client_cases in cases.json."
 },
 "build_rule": {
  "key": "build",
  "regex": "^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}\\+([0-9a-f]{12}|dev)$",
  "_note": "A build id: semver + git sha (12 hex), or +dev for a local build. Only on a product's own `started` line. client = <product>/<build id>."
 },
 "levels": [
  "ERROR",
  "WARN",
  "INFO",
  "DEBUG",
  "TRACE"
 ],
 "library": {
  "_note": "Targets we do not own. Input carries product; sqlx::query input fields are the classifier output (op, table, rows, elapsed_ms) plus raw lib fields, which are dropped. Every other crate: event `lib event`, location=<first path segment of the target>, keys location and error only; error = the lib message, kept only at WARN and above. Lib events are exempt from the dropped-key count.",
  "cloud": {
   "sqlx::query": {
    "component": "cloud.db",
    "events": [
     "query done",
     "query slow"
    ],
    "keys": [
     "op",
     "table",
     "rows",
     "elapsed_ms"
    ]
   },
   "other": {
    "component": "cloud.lib",
    "event": "lib event",
    "keys": [
     "location",
     "error"
    ],
    "error_min_level": "WARN"
   }
  },
  "runner": {
   "sqlx::query": {
    "component": "runner.db",
    "events": [
     "query done",
     "query slow"
    ],
    "keys": [
     "op",
     "table",
     "rows",
     "elapsed_ms"
    ]
   },
   "other": {
    "component": "runner.lib",
    "event": "lib event",
    "keys": [
     "location",
     "error"
    ],
    "error_min_level": "WARN"
   }
  }
 },
 "filter": {
  "env": {
   "cloud": "ZRIZ_LOG",
   "runner": "ZRIZ_LOG",
   "worker": "ZRIZ_LOG",
   "zz": "ZZ_LOG"
  },
  "grammar": "<level> or <level>,<target>=<level>,... ; target = component name for own lines, the library real target for library lines (sqlx::query=debug); an override matches only its own target string (cloud.db=debug does not affect sqlx::query); levels lower-case error warn info debug trace",
  "default_filter": {
   "cloud": "warn,cloud=info",
   "runner": "warn,runner=info",
   "worker": "warn,worker=info",
   "zz": "warn,zz=info"
  },
  "default_note": "Used when no env var is set. zz: when ZZ_LOG is set it is used as is; unset, zz prints nothing."
 }
}
