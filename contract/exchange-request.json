{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/exchange-request.json",
  "type": "object",
  "properties": {
    "v": {"const": 1},
    "runner": {
      "type": "object",
      "properties": {
        "runner-id": {"type": "string"},
        "version": {"type": "string"},
        "ops": {"type": "array", "items": {"type": "string"}},
        "resources": {"type": "array", "items": {"type": "string"}},
        "max-inflight": {"type": "integer"},
        "env": {"type": "string"}
      },
      "required": ["runner-id", "version", "ops", "resources", "max-inflight"],
      "additionalProperties": true
    },
    "inflight": {"type": "integer"},
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "v": {"const": 1},
          "t": {"enum": ["op", "result", "error"]},
          "id": {"type": "string"},
          "re": {"type": ["string", "null"]},
          "ts": {"type": "integer"},
          "d": {"type": "object"}
        },
        "required": ["v", "t", "id", "re", "ts", "d"],
        "additionalProperties": true
      }
    }
  },
  "required": ["v", "runner", "inflight", "frames"],
  "additionalProperties": true
}
