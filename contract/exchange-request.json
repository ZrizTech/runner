{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/exchange-request.json",
  "type": "object",
  "properties": {
    "v": {"const": 1},
    "runner": {
      "type": "object",
      "properties": {
        "runner-id": {"type": "string"},
        "version": {"type": "string"},
        "ops": {"type": "array", "items": {"type": "string"}},
        "resources": {"type": "array", "items": {"type": "string"}},
        "max-inflight": {"type": "integer"},
        "env": {"type": "string"}
      },
      "required": ["runner-id", "version", "ops", "resources", "max-inflight"],
      "additionalProperties": true
    },
    "inflight": {"type": "integer"},
    "health": {
      "type": "object",
      "properties": {
        "boot-id": {"type": "string"},
        "state": {"enum": ["ok", "busy", "degraded"]},
        "browser": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resource": {"type": "string"},
              "busy": {"type": "integer", "minimum": 0},
              "limit": {"type": "integer", "minimum": 0}
            },
            "required": ["resource", "busy", "limit"],
            "additionalProperties": false
          }
        },
        "cli": {
          "type": "object",
          "properties": {
            "busy": {"type": "integer", "minimum": 0},
            "limit": {"type": "integer", "minimum": 0}
          },
          "required": ["busy", "limit"],
          "additionalProperties": false
        },
        "worker": {"enum": ["up", "down"]},
        "refused": {"type": "integer", "minimum": 0}
      },
      "required": ["boot-id", "state", "refused"],
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "v": {"const": 1},
          "t": {"enum": ["op", "result", "error"]},
          "id": {"type": "string"},
          "re": {"type": ["string", "null"]},
          "ts": {"type": "integer"},
          "d": {"type": "object"}
        },
        "required": ["v", "t", "id", "re", "ts", "d"],
        "additionalProperties": true
      }
    }
  },
  "required": ["v", "runner", "inflight", "health", "frames"],
  "additionalProperties": true
}
