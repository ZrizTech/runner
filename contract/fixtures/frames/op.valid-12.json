{
  "op-id": "op-20",
  "run-id": "run-1",
  "step-index": 0,
  "kind": "browser.page",
  "resource": "shop-web",
  "timeout-ms": 10000,
  "args": {
    "commands": [
      {
        "do": "goto",
        "path": "/login"
      },
      {
        "do": "fill",
        "target": {
          "label": "Email"
        },
        "value": "qa@qa.example.com"
      },
      {
        "do": "fill",
        "target": {
          "label": "Password"
        },
        "value": "${SHOP_QA_PASSWORD}"
      },
      {
        "do": "click",
        "target": {
          "role": "button",
          "name": "Sign in",
          "exact": true
        }
      },
      {
        "do": "wait-for",
        "url": "/welcome"
      },
      {
        "do": "read",
        "as": "org",
        "what": "text",
        "target": {
          "css": "[data-org-id]",
          "nth": 0
        }
      }
    ]
  },
  "project": [
    [
      "ok"
    ],
    [
      "reads",
      "org"
    ]
  ]
}
