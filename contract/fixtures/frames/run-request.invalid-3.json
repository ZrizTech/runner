{
  "env": "local",
  "pipeline": {
    "steps": [
      {
        "log": "hi"
      }
    ]
  },
  "resources": {
    "web": {
      "type": "browser",
      "description": "web app",
      "timeout-ms": 10000,
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "actions": {
        "sign-in": {
          "commands": [
            {
              "do": "goto",
              "path": "/login"
            },
            {
              "do": "fill",
              "target": {
                "label": "Email"
              },
              "value": "{email}"
            },
            {
              "do": "fill",
              "target": {
                "label": "Password"
              },
              "value": "{password}"
            },
            {
              "do": "click",
              "target": {
                "role": "button",
                "name": "Sign in"
              }
            },
            {
              "do": "wait-for",
              "url": "/welcome"
            },
            {
              "do": "read",
              "as": "org",
              "what": "text",
              "target": {
                "css": "[data-org-id]"
              }
            }
          ]
        },
        "title": {
          "commands": [
            {
              "do": "goto",
              "path": "/"
            },
            {
              "do": "read",
              "as": "title",
              "what": "title"
            }
          ],
          "timeout-ms": 5000
        }
      },
      "origins": [
        "https://x.example"
      ]
    },
    "zz": {
      "type": "cli",
      "description": "zz binary",
      "actions": {
        "version": {
          "command": "zz",
          "args": [
            "version"
          ]
        },
        "login-start": {
          "command": "zz",
          "args": [
            "login",
            "--no-browser"
          ],
          "mode": "start",
          "handle": "login"
        },
        "login-code": {
          "mode": "read",
          "handle": "login",
          "until": {
            "stream": "stderr",
            "after": " and enter "
          },
          "extract": {
            "user-code": {
              "stream": "stderr",
              "after": " and enter "
            }
          }
        },
        "login-wait": {
          "mode": "wait",
          "handle": "login"
        },
        "run": {
          "command": "zz",
          "args": [
            "run",
            "{file}",
            "--local",
            "--json"
          ],
          "stdout": "json",
          "timeout-ms": 60000
        }
      }
    }
  },
  "environment": {
    "values": {
      "API_URL": "http://api.test"
    }
  }
}
