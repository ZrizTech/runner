{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/exchange-response.json",
  "type": "object",
  "properties": {
    "v": {"const": 1},
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "v": {"const": 1},
          "t": {"enum": ["op", "result", "error"]},
          "id": {"type": "string"},
          "re": {"type": ["string", "null"]},
          "ts": {"type": "integer"},
          "d": {"type": "object"}
        },
        "required": ["v", "t", "id", "re", "ts", "d"],
        "additionalProperties": true
      }
    }
  },
  "required": ["v", "frames"],
  "additionalProperties": true
}
