{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/exchange-response.json",
  "type": "object",
  "properties": {
    "v": {"const": 1},
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "v": {"const": 1},
          "t": {"enum": ["op", "result", "error"]},
          "id": {"type": "string"},
          "re": {"type": ["string", "null"]},
          "ts": {"type": "integer"},
          "d": {"type": "object"}
        },
        "required": ["v", "t", "id", "re", "ts", "d"],
        "additionalProperties": true
      }
    },
    "ended-runs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "run-id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "trace-id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
        },
        "required": ["run-id", "trace-id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["v", "frames", "ended-runs"],
  "additionalProperties": true
}
