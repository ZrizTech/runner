{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/login-device-poll-response.json",
  "type": "object",
  "properties": {
    "status": {"enum": ["pending", "approved", "expired"]},
    "api-key": {"type": "string", "minLength": 1},
    "org-id": {"type": "string", "minLength": 1},
    "api-url": {"type": "string", "minLength": 1},
    "org-name": {"type": "string", "minLength": 1},
    "email": {"type": "string"}
  },
  "required": ["status"],
  "if": {
    "properties": {"status": {"const": "approved"}},
    "required": ["status"]
  },
  "then": {"required": ["api-key", "org-id", "api-url", "org-name"]},
  "else": {
    "not": {
      "anyOf": [
        {"required": ["api-key"]},
        {"required": ["org-id"]},
        {"required": ["api-url"]},
        {"required": ["org-name"]},
        {"required": ["email"]}
      ]
    }
  },
  "additionalProperties": false
}
