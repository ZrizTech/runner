{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/space-ref.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "run"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "contract"
        },
        "project": {
          "$ref": "https://zriz.io/contract/project-name.json"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "project",
        "name",
        "version"
      ],
      "additionalProperties": false
    }
  ]
}
