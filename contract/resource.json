{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/resource.json",
  "$defs": {
    "http-action": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string"
        },
        "redirect": {
          "enum": [
            "follow",
            "none"
          ],
          "description": "follow HTTP redirects; default follow"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout-ms": {
          "type": "integer"
        }
      },
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": false
    },
    "sql-action": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "timeout-ms": {
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "css": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?![\\s\\S]*>>)"
        },
        "test-id": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "type": "boolean"
        },
        "nth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "role"
          ]
        },
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "css"
          ]
        },
        {
          "required": [
            "test-id"
          ]
        }
      ],
      "additionalProperties": false,
      "description": "closed locator; exactly one of role, label, text, css, test-id; css must not contain >>"
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "goto"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "do",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "click"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "fill"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "do",
            "target",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "press-seq"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "do",
            "target",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "select"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "do",
            "target",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "check"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "uncheck"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "press"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "key": {
              "enum": [
                "Enter",
                "Tab",
                "Escape",
                "ArrowUp",
                "ArrowDown",
                "ArrowLeft",
                "ArrowRight"
              ]
            }
          },
          "required": [
            "do",
            "target",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "wait-for"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "state": {
              "enum": [
                "visible",
                "hidden",
                "attached"
              ]
            }
          },
          "required": [
            "do",
            "target",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "wait-for"
            },
            "url": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "do",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "read"
            },
            "as": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "what": {
              "type": "string",
              "pattern": "^(text|value|count|visible|url|title|overflow-x|attr:[A-Za-z][A-Za-z0-9_-]*)$"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "as",
            "what"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "viewport"
            },
            "width": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            },
            "height": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            }
          },
          "required": [
            "do",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      ]
    },
    "command-list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "browser-action": {
      "type": "object",
      "properties": {
        "commands": {
          "$ref": "#/$defs/command-list"
        },
        "timeout-ms": {
          "type": "integer"
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    },
    "cli-action": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "run",
            "start",
            "read",
            "wait",
            "stop"
          ]
        },
        "handle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "until": {
          "type": "object",
          "properties": {
            "stream": {
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "after": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "stream",
            "after"
          ],
          "additionalProperties": false
        },
        "extract": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "stream": {
                "enum": [
                  "stdout",
                  "stderr"
                ]
              },
              "after": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "stream",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "stdout": {
          "enum": [
            "json"
          ]
        },
        "timeout-ms": {
          "type": "integer"
        },
        "env": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "description": "names of with keys whose resolved values become child env vars"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "mode",
            "handle"
          ],
          "properties": {
            "mode": {
              "enum": [
                "read",
                "wait",
                "stop"
              ]
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "start"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "handle"
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "http"
        },
        "description": {
          "type": "string"
        },
        "base-url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout-ms": {
          "type": "integer"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/http-action"
          }
        }
      },
      "required": [
        "type",
        "base-url",
        "actions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "sql"
        },
        "description": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "read-only": {
          "type": "boolean"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sql-action"
          }
        }
      },
      "required": [
        "type",
        "connection",
        "actions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "browser"
        },
        "description": {
          "type": "string"
        },
        "timeout-ms": {
          "type": "integer"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            },
            "height": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/browser-action"
          }
        }
      },
      "required": [
        "type",
        "actions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "cli"
        },
        "description": {
          "type": "string"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cli-action"
          }
        }
      },
      "required": [
        "type",
        "actions"
      ],
      "additionalProperties": false
    }
  ]
}
