{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/space-contract-request.json",
  "type": "object",
  "properties": {
    "format": {
      "enum": [
        "openapi",
        "asyncapi",
        "json-schema",
        "graphql",
        "protobuf",
        "text"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400000,
      "not": {
        "pattern": "(zk|zrt)_[A-Za-z0-9_-]{20,}|[A-Za-z][A-Za-z0-9+.-]*://[^\\s/:@]*:[^\\s/@]+@"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "pattern": "(zk|zrt)_[A-Za-z0-9_-]{20,}|[A-Za-z][A-Za-z0-9+.-]*://[^\\s/:@]*:[^\\s/@]+@"
      }
    }
  },
  "required": [
    "format",
    "body",
    "summary"
  ],
  "additionalProperties": false
}
