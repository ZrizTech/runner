{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/cause.json",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "enum": [
        "target",
        "pipeline",
        "runner",
        "service",
        "limit",
        "network"
      ]
    },
    "retry": {
      "enum": [
        "no",
        "later",
        "now",
        "unknown"
      ]
    },
    "message": {
      "type": "string"
    },
    "where": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "name": {"$ref": "https://zriz.io/contract/pipeline.json#/$defs/step-name"},
          "action": {"type": "string"},
          "item": {"type": "integer", "minimum": 1},
          "of": {"type": "integer", "minimum": 1}
        },
        "required": ["step"],
        "dependentRequired": {"item": ["of"], "of": ["item"]},
        "additionalProperties": false
      }
    },
    "details": {
      "type": "object"
    },
    "more": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "reason",
    "retry",
    "message",
    "details"
  ],
  "if": {
    "properties": {"reason": {"not": {"const": "canceled"}}}
  },
  "then": {
    "required": ["side"]
  },
  "additionalProperties": false
}
