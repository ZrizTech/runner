{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/contract/members.json",
  "type": "object",
  "properties": {
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account-id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "member",
              "viewer"
            ]
          }
        },
        "required": [
          "account-id",
          "name",
          "email",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "invites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "member",
              "viewer"
            ]
          },
          "expires-at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expires-at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "members",
    "invites"
  ],
  "additionalProperties": false
}
