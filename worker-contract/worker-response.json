{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/worker-contract/worker-response.json",
  "title": "worker to runner response (one JSON line)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "ok",
        "browser",
        "cli",
        "boot-id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "ping"
        },
        "ok": {
          "const": true
        },
        "browser": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource",
              "busy"
            ],
            "properties": {
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "busy": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "busy",
            "limit"
          ],
          "properties": {
            "busy": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "boot-id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "ok",
        "closed"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "run.close"
        },
        "ok": {
          "const": true
        },
        "closed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op-id",
        "ok",
        "out"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op-id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": true
        },
        "out": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "ok",
        "reason",
        "message"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op-id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": false
        },
        "reason": {
          "enum": [
            "bad-json",
            "bad-version",
            "unknown-kind",
            "bad-request",
            "request-too-large",
            "not-implemented",
            "at-capacity",
            "context-lost",
            "handle-busy",
            "no-handle",
            "too-many-handles",
            "spawn-failed",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 200
        },
        "max-contexts": {
          "type": "integer",
          "minimum": 1
        },
        "busy": {
          "type": "integer",
          "minimum": 0
        },
        "waited-ms": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "idle-ms": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "enum": [
            "idle"
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    }
  }
}
