{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zriz.io/worker-contract/worker-request.json",
  "title": "runner to worker request (one JSON line)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "ping"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op-id",
        "run",
        "kind",
        "policy",
        "args",
        "deadline-ms"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op-id": {
          "$ref": "#/$defs/id"
        },
        "run": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "browser.page"
        },
        "policy": {
          "$ref": "#/$defs/browser-policy"
        },
        "args": {
          "$ref": "#/$defs/browser-args"
        },
        "deadline-ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "trace-id": {
          "$ref": "#/$defs/trace-id"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op-id",
        "run",
        "kind",
        "policy",
        "args",
        "deadline-ms"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op-id": {
          "$ref": "#/$defs/id"
        },
        "run": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "cli.exec"
        },
        "policy": {
          "$ref": "#/$defs/cli-policy"
        },
        "args": {
          "$ref": "#/$defs/cli-args"
        },
        "deadline-ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "trace-id": {
          "$ref": "#/$defs/trace-id"
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "browser-policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "base-url",
        "origins"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/id"
        },
        "base-url": {
          "type": "string",
          "pattern": "^https?://[^/?#\\s]+/?$",
          "maxLength": 256
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^https?://[^/?#\\s]+$",
            "maxLength": 256
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            },
            "height": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            }
          }
        },
        "max-contexts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "idle-ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      }
    },
    "browser-args": {
      "type": "object",
      "properties": {
        "commands": {
          "$ref": "#/$defs/command-list"
        },
        "capture": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "command-timeout-ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "css": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?![\\s\\S]*>>)"
        },
        "test-id": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "type": "boolean"
        },
        "nth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "role"
          ]
        },
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "css"
          ]
        },
        {
          "required": [
            "test-id"
          ]
        }
      ],
      "additionalProperties": false,
      "description": "closed locator; exactly one of role, label, text, css, test-id; css must not contain >>"
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "goto"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "do",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "click"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "fill"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "do",
            "target",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "press-seq"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "do",
            "target",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "select"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "do",
            "target",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "check"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "uncheck"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "press"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "key": {
              "enum": [
                "Enter",
                "Tab",
                "Escape",
                "ArrowUp",
                "ArrowDown",
                "ArrowLeft",
                "ArrowRight"
              ]
            }
          },
          "required": [
            "do",
            "target",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "wait-for"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "state": {
              "enum": [
                "visible",
                "hidden",
                "attached"
              ]
            }
          },
          "required": [
            "do",
            "target",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "wait-for"
            },
            "url": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "do",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "read"
            },
            "as": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "what": {
              "type": "string",
              "pattern": "^(text|value|count|visible|url|title|overflow-x|attr:[A-Za-z][A-Za-z0-9_-]*)$"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "required": [
            "do",
            "as",
            "what"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "const": "viewport"
            },
            "width": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            },
            "height": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            }
          },
          "required": [
            "do",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      ]
    },
    "command-list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "cli-policy": {
      "description": "the resolved command entry of the runner config (plan 3.1); the run dir is /tmp/zriz-run/<sha256(run)[..16]>/<resource>/, HOME and cwd, removed on idle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "path",
        "timeout-ms",
        "max-life-ms",
        "max-output-bytes"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 1024
        },
        "argv-prefix": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "cwd": {
          "const": "run"
        },
        "timeout-ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "max-life-ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "max-output-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max-handles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "idle-ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      }
    },
    "cli-args": {
      "description": "op args after the runner shape-checked the argv tail and resolved env values",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "run",
            "start",
            "read",
            "wait",
            "stop"
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "handle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "until": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stream",
            "after"
          ],
          "properties": {
            "stream": {
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "after": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "extract": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stream",
              "after"
            ],
            "properties": {
              "stream": {
                "enum": [
                  "stdout",
                  "stderr"
                ]
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "trace-id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
