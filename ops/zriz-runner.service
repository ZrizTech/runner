# Example systemd unit for the zriz runner (binary shape: http and sql resources).
# Copy to /etc/systemd/system/zriz-runner.service.
# Files in /etc/zriz-runner/:
#   config.json  mode 644. It holds no secret value, and the runner (DynamicUser) must read it.
#   runner.env   mode 600, owner root. systemd reads it as root (EnvironmentFile), the runner cannot.
#                Format: one NAME=value per line. The value has no quotes, no backslash,
#                no space at the start or the end, and no line break (zz refuses other values).
#                Then systemd and Docker (--env-file) read the same value.
# The runner opens no port. It only connects out.
[Unit]
Description=zriz runner
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/zriz-runner/runner.env
Environment=ZRIZ_RUNNER_CONFIG=/etc/zriz-runner/config.json
ExecStart=/usr/local/bin/zriz-runner
Restart=on-failure
RestartSec=10
# Exit 2 = the cloud refused the key (401), the key has no right (403), or the config is bad. A restart would repeat it for ever.
RestartPreventExitStatus=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
